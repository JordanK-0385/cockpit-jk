# =====================================================================
# Cockpit JK — environment variables
#
# Two categories:
#   1. Public (VITE_*) — inlined into the client bundle, fine to expose.
#   2. Server-only — used inside /api/* Vercel functions, NEVER prefixed
#      with VITE_. These would leak if exposed.
#
# For local dev: copy this to .env.local and fill values.
# For Vercel:    add each in Project Settings → Environment Variables.
# =====================================================================

# --- PUBLIC (client-side, OK to expose) -------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Email allowed to log in. Single-tenant guard on the auth flow.
VITE_AUTHORIZED_EMAIL=jordan.koskas@gmail.com

# Google Calendar OAuth scope (the user's own token, requested via Firebase Auth).
VITE_GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar

# --- SERVER-ONLY (never prefix with VITE_) ----------------------------
# Used by /api/airtable/*
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appyvKVq6Q6kr37La

# Used by /api/claude/* (Sprint 2+)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Used by /api/n8n/* (Sprint 5)
N8N_BASE_URL=https://n8n.srv786690.hstgr.cloud
N8N_API_KEY=

# Firebase Admin (for verifying ID tokens on the server).
# Create a service account in Firebase Console → Project Settings → Service accounts,
# download the JSON, and paste the entire JSON as a single line here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email allowed to call /api/* endpoints. Should match VITE_AUTHORIZED_EMAIL.
AUTHORIZED_EMAIL=jordan.koskas@gmail.com
