rules_version = '2';

// Cockpit JK — règles de sécurité Firestore (Sprint 2 étape 3).
//
// ⚠️ NON DÉPLOYÉ PAR CETTE PR. À déployer manuellement par Jordan via
//    `firebase deploy --only firestore:rules` (ou la console Firebase).
//
// Principe : deny par défaut. Le seul accès autorisé est celui de
// l'utilisateur unique du cockpit à SA propre sous-collection de messages :
//   - request.auth != null                         (authentifié)
//   - request.auth.uid == uid                       (ses propres documents)
//   - request.auth.token.email == AUTHORIZED_EMAIL  (le seul compte autorisé)
//
// L'e-mail doit rester aligné avec VITE_AUTHORIZED_EMAIL (front) et l'e-mail
// autorisé côté /api/*.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedUser(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'jordan.koskas@gmail.com';
    }

    // Historique de chat : users/{uid}/messages/{messageId}
    match /users/{uid}/messages/{messageId} {
      allow read, write: if isAuthorizedUser(uid);
    }

    // Scores du module Apprendre : users/{uid}/apprentissage_scores/{attemptId}
    match /users/{uid}/apprentissage_scores/{attemptId} {
      allow read, write: if isAuthorizedUser(uid);
    }

    // Préférences UI : users/{uid}/preferences/{prefId} (doc 'ui', cf.
    // PreferencesProvider). Sans cette règle, le deny par défaut ci-dessous
    // renvoyait « Missing or insufficient permissions » au chargement.
    match /users/{uid}/preferences/{prefId} {
      allow read, write: if isAuthorizedUser(uid);
    }

    // NB : le cache IA Monitoring (collection monitoringAi/{uid}) est écrit ET
    // lu côté serveur via firebase-admin, qui bypass ces règles — aucune règle
    // client n'est requise pour lui.

    // Tout le reste : refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
